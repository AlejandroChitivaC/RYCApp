<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- API stateless con JWT. No hay cookie de sesión que CSRF pueda falsificar. -->
    <Match>
        <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED"/>
    </Match>
    <Match>
        <Source name="~.*Test\.java"/>
    </Match>
    <Match>
        <Source name="~.*IT\.java"/>
    </Match>
</FindBugsFilter>
